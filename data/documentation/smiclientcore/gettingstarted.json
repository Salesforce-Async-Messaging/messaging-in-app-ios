{"metadata":{"title":"Getting Started with SMIClientCore","roleHeading":"Article","modules":[{"name":"SMIClientCore"}],"role":"article"},"kind":"article","sections":[],"identifier":{"url":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"This guide walks through the essential steps to initialize the SDK, establish a connection, and start a conversation. The initialization sequence is:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/Configuration","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient","isActive":true,"type":"reference"},{"type":"text","text":" using "},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreFactory","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Register delegates"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient\/start()","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/ConversationClient","isActive":true,"type":"reference"}]}]}]},{"type":"heading","text":"Create a Configuration","anchor":"Create-a-Configuration","level":2},{"type":"paragraph","inlineContent":[{"text":"Create a ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/Configuration","type":"reference","isActive":true},{"text":" using the JSON config file downloaded from your Salesforce org:","type":"text"}]},{"type":"codeListing","code":["guard let configURL = Bundle.main.url(forResource: \"configFile\",","                                       withExtension: \"json\") else {","    return","}","","guard let config = Configuration(url: configURL,","                                  userVerificationRequired: false) else {","    return","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Alternatively, configure programmatically:","type":"text"}]},{"type":"codeListing","code":["let config = Configuration(serviceAPI: URL(string: \"https:\/\/your-endpoint.salesforce.com\")!,","                            organizationId: \"00Dxx0000000000\",","                            developerName: \"Your_Deployment_API_Name\",","                            userVerificationRequired: false)"],"syntax":"swift"},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"userVerificationRequired"},{"type":"text","text":" parameter must match your deployment’s verification settings. A mismatch results in authorization failures."}],"type":"paragraph"}],"name":"Important"},{"type":"heading","text":"Create a CoreClient","anchor":"Create-a-CoreClient","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreFactory","type":"reference","isActive":true},{"text":" to create a ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient","type":"reference","isActive":true},{"text":" instance:","type":"text"}]},{"type":"codeListing","code":["let coreClient = CoreFactory.create(withConfig: config)"],"syntax":"swift"},{"type":"aside","style":"warning","content":[{"inlineContent":[{"type":"text","text":"The factory returns a weak reference. You must store the result in a strong property to prevent the client from being deallocated."}],"type":"paragraph"}],"name":"Warning"},{"type":"paragraph","inlineContent":[{"text":"The factory returns the same ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient","type":"reference","isActive":true},{"text":" instance when called with an unchanged configuration. If you pass a different configuration, the existing client is stopped and deallocated, and a new client is returned.","type":"text"}]},{"type":"heading","text":"Register Delegates","anchor":"Register-Delegates","level":2},{"type":"paragraph","inlineContent":[{"text":"Register delegates before calling ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient\/start()","type":"reference","isActive":true},{"text":" to ensure you receive all events:","type":"text"}]},{"type":"codeListing","code":["coreClient.addDelegate(delegate: self)","coreClient.setPreChatDelegate(delegate: self, queue: .main)","coreClient.setUserVerificationDelegate(delegate: self, queue: .main)","coreClient.setTemplatedUrlDelegate(delegate: self, queue: .main)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"DispatchQueue.main","type":"codeVoice"},{"text":" if your delegate methods update the UI directly.","type":"text"}]},{"type":"heading","text":"Start the Connection","anchor":"Start-the-Connection","level":2},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient\/start()","type":"reference","isActive":true},{"text":" to begin listening for realtime events:","type":"text"}]},{"type":"codeListing","code":["coreClient.start()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Once started, the client aggressively maintains the connection and delivers events through ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreDelegate","type":"reference","isActive":true},{"text":". Push notifications are suppressed while started. No realtime events are delivered until ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient\/start()","type":"reference","isActive":true},{"text":" is called.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient\/stop()","type":"reference","isActive":true},{"text":" when the app moves to the background. This conserves battery and network resources, and push notifications resume delivery:","type":"text"}]},{"type":"codeListing","code":["func sceneDidEnterBackground(_ scene: UIScene) {","    coreClient.stop()","}","","func sceneWillEnterForeground(_ scene: UIScene) {","    coreClient.start()","}"],"syntax":"swift"},{"type":"heading","text":"Managing Conversations","anchor":"Managing-Conversations","level":2},{"type":"paragraph","inlineContent":[{"text":"Obtain a ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/ConversationClient","type":"reference","isActive":true},{"text":" to interact with a specific conversation. Check for existing conversations first, and generate a new UUID only if none exist:","type":"text"}]},{"type":"codeListing","code":["coreClient.conversations(withLimit: 1, sortedByActivityDirection: .descending) { conversations, error in","    let conversationId: UUID","    if let existing = conversations?.first {","        conversationId = existing.identifier","    } else {","        conversationId = UUID()","    }","","    let conversationClient = coreClient.conversationClient(with: conversationId)","}"],"syntax":"swift"},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"Always use a randomly generated UUID for new conversation IDs. Never use deterministic values (customer IDs, account numbers) — reusing IDs after a reinstall causes HTTP 403 errors."}],"type":"paragraph"}],"name":"Important"},{"type":"heading","text":"Sending Messages","anchor":"Sending-Messages","level":2},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/ConversationClient","type":"reference","isActive":true},{"text":" to send text messages and file attachments:","type":"text"}]},{"type":"codeListing","code":["conversationClient.send(message: \"Hello, I need help with my order\")"],"syntax":"swift"},{"type":"codeListing","code":["conversationClient.send(file: pdfData, fileName: \"receipt.pdf\", message: \"See attached\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Entries appear in the local conversation feed immediately and are delivered to the server asynchronously.","type":"text"}]},{"type":"heading","text":"Observing Events","anchor":"Observing-Events","level":2},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreDelegate","type":"reference","isActive":true},{"text":" to observe realtime activity across all conversations:","type":"text"}]},{"type":"codeListing","code":["extension MyViewModel: CoreDelegate {","    func core(_ core: CoreClient,","              conversation: Conversation,","              didReceiveEntries entries: [ConversationEntry],","              paged: Bool) {","        \/\/ paged == true indicates entries loaded from local storage,","        \/\/ not realtime events from the server.","        for entry in entries {","            \/\/ Update your UI with the new entry","        }","    }","","    func core(_ core: CoreClient, didError error: Error) {","        let code = (error as NSError).code","        let message = (error as NSError).localizedDescription","        \/\/ Handle error","    }","","    func core(_ core: CoreClient,","              conversation: Conversation,","              didReceiveEvents events: [ConversationEntry]) {","        \/\/ Typing indicators and other transient events","    }","","    func core(_ core: CoreClient,","              didChangeNetworkState state: NetworkConnectivityState) {","        \/\/ Connection state changed","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"For conversation-scoped events, implement ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/ConversationClientDelegate","type":"reference","isActive":true},{"text":" on the ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/ConversationClient","type":"reference","isActive":true},{"text":" instead.","type":"text"}]},{"type":"heading","text":"Pre-Chat Configuration","anchor":"Pre-Chat-Configuration","level":2},{"type":"paragraph","inlineContent":[{"text":"If your deployment uses pre-chat fields, retrieve the remote configuration and submit it when creating a conversation:","type":"text"}]},{"type":"codeListing","code":["coreClient.retrieveRemoteConfiguration { remoteConfig, error in","    guard let remoteConfig = remoteConfig else { return }","","    for field in remoteConfig.preChatConfiguration?.first?.preChatFields ?? [] {","        if field.isRequired {","            field.value = \"value from your UI\"","        }","    }","","    conversationClient.submit(remoteConfig: remoteConfig, createConversationOnSubmit: true)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To supply hidden pre-chat values (not visible to the user but sent to the agent), implement ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/HiddenPreChatDelegate","type":"reference","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","code":["extension MyViewModel: HiddenPreChatDelegate {","    func core(_ core: CoreClient,","              conversation: Conversation,","              didRequestPrechatValues hiddenPreChatFields: [HiddenPreChatField],","              completionHandler: @escaping HiddenPreChatValueCompletion) {","        for field in hiddenPreChatFields {","            switch field.name {","            case \"CustomerId\":","                field.value = \"customer-123\"","            default:","                break","            }","        }","        completionHandler(hiddenPreChatFields)","    }","}"],"syntax":"swift"},{"type":"heading","text":"User Verification","anchor":"User-Verification","level":2},{"type":"paragraph","inlineContent":[{"text":"For deployments that require authenticated users, set ","type":"text"},{"code":"userVerificationRequired","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" in your configuration and implement ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/UserVerificationDelegate","type":"reference","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","code":["extension MyViewModel: UserVerificationDelegate {","    func core(_ core: CoreClient,","              userVerificationChallengeWith reason: ChallengeReason,","              completionHandler completion: @escaping UserVerificationChallengeCompletion) {","        let token: String","        switch reason {","        case .initial:","            token = fetchJwt()","        case .refresh, .expired:","            token = renewJwt()","        case .malformed:","            token = fetchJwt()","        default:","            return","        }","","        completion(UserVerification(customerIdentityToken: token, type: .JWT))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The delegate is called whenever the SDK needs a token — at initial connection, on token expiry, or if the previous token was rejected.","type":"text"}]},{"type":"heading","text":"Push Notifications","anchor":"Push-Notifications","level":2},{"type":"paragraph","inlineContent":[{"text":"Push notification setup requires two steps:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Step 1:"}],"type":"strong"},{"text":" Provide the APNS device token to the factory. This stores the token locally without making any network requests:","type":"text"}]},{"type":"codeListing","code":["func application(_ application: UIApplication,","                 didRegisterForRemoteNotificationsWithDeviceToken deviceToken: Data) {","    let token = deviceToken.map { String(format: \"%02.2hhx\", $0) }.joined()","    CoreFactory.provide(deviceToken: token)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Step 2:"}],"type":"strong"},{"text":" Register the device with the backend to begin receiving push notifications:","type":"text"}]},{"type":"codeListing","code":["coreClient.register(deviceToken: token) { error in","    if let error = error {","        \/\/ Handle registration failure","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Push notifications are delivered when the realtime connection is not active (i.e., when ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient\/stop()","type":"reference","isActive":true},{"text":" has been called or the app is in the background).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To stop receiving push notifications, call ","type":"text"},{"identifier":"doc:\/\/com.salesforce.SMIClientCore\/documentation\/SMIClientCore\/CoreClient\/deregisterDevice(completion:)","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"heading",